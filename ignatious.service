[Unit]
Description=Ignatious Kanban Board
After=network.target

[Service]
Type=simple
User=ignatious
WorkingDirectory=/opt/ignatious
Environment="IGNATIOUS_DATABASE_URL=sqlite:////var/lib/ignatious/ignatious.db"
ExecStart=/opt/ignatious/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000
StateDirectory=ignatious
UMask=0077
NoNewPrivileges=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
